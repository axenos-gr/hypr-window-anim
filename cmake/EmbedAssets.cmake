# Usage: cmake -DROOT=<src> -DOUT=<file.cpp> -DFILES="a|b|c" -P EmbedAssets.cmake

string(REPLACE "|" ";" FILES "${FILES}")

set(body "// Generated by cmake/EmbedAssets.cmake. Do not edit.\n#include \"hwa/Assets.hpp\"\n\nnamespace hwa::assets {\n    namespace {\n")
set(table "")
set(idx 0)

foreach(f IN LISTS FILES)
    file(READ "${ROOT}/${f}" data)
    string(FIND "${data}" ")HWA_ASSET\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${f} contains the raw string delimiter")
    endif()
    string(APPEND body "        constexpr std::string_view ASSET_${idx} = R\"HWA_ASSET(${data})HWA_ASSET\";\n")
    string(APPEND table "            SAsset{\"${f}\", ASSET_${idx}},\n")
    math(EXPR idx "${idx} + 1")
endforeach()

string(APPEND body "\n        constexpr std::array ASSETS = {\n${table}        };\n    }\n\n")
string(APPEND body "    std::span<const SAsset> all() {\n        return ASSETS;\n    }\n}\n")

file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
